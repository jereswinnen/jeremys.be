---
layout: layouts/base.njk
title: Home
permalink: /
---

<section class="o-grid__popout">
  <h1>Welcome</h1>
  <p>{{ site.description }}</p>
</section>

<section>
  <h2>Recent Posts</h2>
  <ul>
    {% for post in collections.blog %}
      {% if loop.index <= 5 %}
        <li>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          <time datetime="{{ post.date | htmlDateString }}"
            >{{ post.date | readableDate }}</time
          >
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>

<section>
  <h2>Work</h2>
  <ul>
    {% for item in collections.work | reverse %}
      {% if loop.index <= 3 %}
        <li>
          <a href="{{ item.url }}">{{ item.data.title }}</a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</section>
