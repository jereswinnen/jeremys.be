<footer class="o-grid__content text-sm text-neutral-secondary">
  <div class="flex items-center justify-between">
    <p>
      &copy; {{ "now" | date('yyyy') }}
      {{ site.author }}
    </p>
    {% if site.social %}
      <ul class="flex items-center gap-3">
        {% for name, url in site.social %}
          <li>
            <a
              class="font-stretch-semi-condensed text-current! border-b border-neutral-tertiary"
              href="{{ url }}"
              >{{ name | capitalize }}</a
            >
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</footer>
