<article class="post-article">
  <h4>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </h4>
  <div class="post-content o-prose">
    {% if post.data.excerpt %}
      <p>{{ post.data.excerpt }}</p>
    {% else %}
      {{ post.templateContent | safe }}
    {% endif %}
  </div>
  <footer class="post-meta">
    {% set time = post.date | formatTime %}
    {% if time %}
      <time datetime="{{ post.date | htmlDateString }}">{{ time }}</time>
    {% endif %}
    {% if post.data.tags.length > 1 %}
      <ul class="post-tags">
        {% for tag in post.data.tags %}
          {% if tag != "articles" %}
            <li>{{ tag }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </footer>
</article>
