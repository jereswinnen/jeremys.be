{% set mentions = webmentions | webmentionsByUrl(page.url) %}
{% set likes = mentions | webmentionsByType("like-of") %}
{% set reposts = mentions | webmentionsByType("repost-of") %}
{% set replies = mentions | webmentionsByType("in-reply-to") %}

{% if mentions.length %}
  <aside class="pt-8 border-t border-neutral-tertiary">
    <h3 class="text-neutral-secondary">Responses</h3>

    {% if likes.length or reposts.length %}
      <div class="flex flex-wrap gap-4 mb-4">
        {% if likes.length %}
          <div class="flex flex-col gap-1">
            <small>{{ likes.length }} like{{ "s" if likes.length != 1 }}</small>
            <ul class="flex flex-wrap gap-1 list-none p-0 m-0">
              {% for like in likes %}
                <li>
                  <a
                    href="{{ like.author.url }}"
                    title="{{ like.author.name }}"
                    rel="noopener"
                    class="block hover:opacity-80 hover:bg-transparent"
                  >
                    <img
                      src="{{ like.author.photo or '/assets/images/avatar-default.svg' }}"
                      alt="{{ like.author.name }}"
                      loading="lazy"
                      width="32"
                      height="32"
                      class="block w-8 h-8 rounded-full object-cover"
                    />
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if reposts.length %}
          <div class="flex flex-col gap-1">
            <small
              >{{ reposts.length }} boost{{ "s" if reposts.length != 1 }}</small
            >
            <ul class="flex flex-wrap gap-1 list-none p-0 m-0">
              {% for repost in reposts %}
                <li>
                  <a
                    href="{{ repost.author.url }}"
                    title="{{ repost.author.name }}"
                    rel="noopener"
                    class="block hover:opacity-80 hover:bg-transparent"
                  >
                    <img
                      src="{{ repost.author.photo or '/assets/images/avatar-default.svg' }}"
                      alt="{{ repost.author.name }}"
                      loading="lazy"
                      width="32"
                      height="32"
                      class="block w-8 h-8 rounded-full object-cover"
                    />
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if replies.length %}
      <div class="flex flex-col gap-2">
        <small
          >{{ replies.length }}
          repl{{ "y" if replies.length == 1 else "ies" }}</small
        >
        <ul class="flex flex-col gap-4 list-none p-0 m-0">
          {% for reply in replies %}
            <li class="flex flex-col gap-1 p-3 bg-neutral-tertiary rounded-lg">
              <div class="flex items-center gap-2">
                <a
                  href="{{ reply.author.url }}"
                  rel="noopener"
                  class="hover:bg-transparent"
                >
                  <img
                    src="{{ reply.author.photo or '/assets/images/avatar-default.svg' }}"
                    alt=""
                    loading="lazy"
                    width="40"
                    height="40"
                    class="w-10 h-10 rounded-full object-cover"
                  />
                </a>
                <div class="flex flex-col">
                  <a
                    href="{{ reply.author.url }}"
                    rel="noopener"
                    class="font-medium text-neutral-primary no-underline"
                    >{{ reply.author.name }}</a
                  >
                  <a href="{{ reply.url }}" rel="noopener"
                    ><small
                      >{{ reply.published | date("LLL d, yyyy") }}</small
                    ></a
                  >
                </div>
              </div>
              {% if reply.content and reply.content.text %}
                <div class="mt-1 o-prose o-prose--small">
                  {{ reply.content.html | safe if reply.content.html else reply.content.text }}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </aside>
{% endif %}
