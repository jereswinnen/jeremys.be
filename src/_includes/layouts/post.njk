---
layout: layouts/base.njk
---

<article class="o-grid__content space-y-3 md:space-y-8">
  <header class="o-grid__popout space-y-2">
    {% if game %}
      {% set gameData = game | getGame(games) %}
      {% if gameData %}
        <div class="game-info">
          {% gameCover game, games %}
          <span class="game-title">{{ gameData.title }}</span>
        </div>
      {% endif %}
    {% endif %}
    {% if date %}
      <time datetime="{{ date | htmlDateString }}"
        ><small>{{ date | readableDate }}</small></time
      >
    {% endif %}
    <h1>{{ title }}</h1>
  </header>

  <div class="o-grid__content o-prose">{{ content | safe }}</div>
</article>
