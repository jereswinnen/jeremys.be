---
layout: layouts/base.njk
---

<article class="page">
  <header class="page-header">
    <h1 class="largeTitle">{{ title }}</h1>
    {% if date %}
      <time datetime="{{ date | htmlDateString }}"
        >{{ date | readableDate }}</time
      >
    {% endif %}
  </header>

  <div class="page-content">{{ content | safe }}</div>
</article>
