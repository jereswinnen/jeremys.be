<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script src="/assets/js/global.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% if title %}{{ title }} -{% endif %} {{ site.title }}</title>
    <meta name="description" content="{{ description or site.description }}" />

    {# Open Graph #}
    {% set ogImage = image %}
    {% if not ogImage %}
      {% set ogImage = content | firstImage %}
    {% endif %}
    {% if not ogImage and game %}
      {% set gameData = game | getGame(games) %}
      {% if gameData and gameData.cover %}
        {% set ogImage = "/assets/images/games/" + gameData.cover %}
      {% endif %}
    {% endif %}
    {% if not ogImage %}
      {% set ogImage = "/assets/images/og-default.jpg" %}
    {% endif %}
    {% if ogImage and not ogImage.startsWith('http') %}
      {% set ogImage = site.url + ogImage %}
    {% endif %}

    <meta property="og:title" content="{{ title or site.title }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:type" content="{% if tags and ('articles' in tags or 'notes' in tags or 'gamelog' in tags) %}article{% else %}website{% endif %}" />
    <meta property="og:image" content="{{ ogImage }}" />

    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <link rel="me" href="{{ site.social.mastodon }}" />
    <link rel="me" href="{{ site.social.github }}" />
    <link rel="webmention" href="https://webmention.io/jeremys.be/webmention" />
    <link rel="pingback" href="https://webmention.io/jeremys.be/xmlrpc" />
    <link rel="stylesheet" href="/assets/css/tailwind.css" />
    <link rel="stylesheet" href="/assets/css/global.css" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="{{ site.title }}"
      href="{{ site.url }}/feed.xml"
    />
  </head>
  <body class="o-grid space-y-6 md:space-y-12 text-pretty antialiased">
    {% include "partials/header.njk" %}

    <main class="o-grid__page space-y-4 md:space-y-14">
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </body>
</html>
