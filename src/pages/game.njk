---
layout: layouts/base.njk
pagination:
  data: gamesWithColors
  size: 1
  alias: game
permalink: /gamelog/{{ game.slug }}/
eleventyComputed:
  title: "{{ game.title }} - Gamelog"
---

<header class="o-grid__popout">
  <div class="flex flex-col items-center gap-2 pt-8 border-t border-neutral-tertiary">
    <div class="game-info">
      {% gameCover game.slug, games %}
      <span class="game-title">{{ game.title }}</span>
    </div>
    {% set gameEntries = collections.gamelog | filterByGame(game.slug) %}
    <small class="text-neutral-secondary">{{ game.platform }} · {{ game.status }} · {{ gameEntries.length }} entries</small>
  </div>
  <h1 class="sr-only">{{ game.title }}</h1>
</header>

<section class="o-grid__content space-y-10">
  {% set gameEntries = collections.gamelog | filterByGame(game.slug) %}
  {% if gameEntries | length > 0 %}
    {% for entry in gameEntries %}
      <article class="o-grid__content space-y-4">
        <header class="flex items-center gap-2">
          <a class="shrink-0" href="{{ entry.url }}">
            <time datetime="{{ entry.date | htmlDateString }}"
              ><small>{{ entry.date | readableDate }}</small></time
            >
          </a>
          <span class="w-full h-px bg-neutral-tertiary"></span>
        </header>
        <div class="o-grid__content o-prose--small">
          {{ entry.content | safe }}
        </div>
      </article>
    {% endfor %}
  {% else %}
    <p>No entries yet.</p>
  {% endif %}
</section>
