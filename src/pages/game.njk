---
layout: layouts/base.njk
pagination:
  data: gamesWithColors
  size: 1
  alias: game
permalink: /gamelog/{{ game.slug }}/
eleventyComputed:
  title: "{{ game.title }} - Gamelog"
---

<header class="o-grid__popout">
  <div
    class="flex flex-col items-center gap-4 pt-8 border-t border-primary--10"
  >
    <img
      src="/src/assets/images/games/{{ game.cover }}"
      alt="{{ game.title }}"
      class="mix-blend-luminosity size-24 hover:mix-blend-normal"
    />
    <div class="flex flex-col items-center">
      <h2 class="largeTitle">{{ game.title }}</h2>
      {% set gameEntries = collections.gamelog | filterByGame(game.slug) %}
      <ul class="flex items-center">
        <li>
          <small>{{ game.platform }}</small>
        </li>
        <li class="mx-1.5">
          <small class="opacity-50">/</small>
        </li>
        <li>
          <small>{{ game.status }}</small>
        </li>
        <li class="mx-1.5">
          <small class="opacity-50">/</small>
        </li>
        <li>
          {% set count = collections.gamelog | filterByGame(game.slug) | length %}
          <small>{{ count }} entr{{ "y" if count == 1 else "ies" }}</small>
        </li>
      </ul>
    </div>
  </div>
</header>

<section class="o-grid__content space-y-10">
  {% set gameEntries = collections.gamelog | filterByGame(game.slug) %}
  {% if gameEntries | length > 0 %}
    {% for entry in gameEntries %}
      <article class="o-grid__content space-y-4">
        <header class="flex items-center gap-2">
          <a class="shrink-0" href="{{ entry.url }}">
            <time datetime="{{ entry.date | htmlDateString }}"
              ><small>{{ entry.date | readableDate }}</small></time
            >
          </a>
          <span class="w-full h-px bg-primary--10"></span>
        </header>
        <div class="o-grid__content o-prose--small">
          {{ entry.content | safe }}
        </div>
      </article>
    {% endfor %}
  {% else %}
    <p>No entries yet.</p>
  {% endif %}
</section>
