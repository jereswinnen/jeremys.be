---
layout: layouts/base.njk
title: Gamelog
permalink: /gamelog/
---

{% set latestEntry = collections.gamelog | first %}
<header class="o-grid__content o-prose">
  {% if latestEntry %}
    <small
      >Last updated:
      <time datetime="{{ latestEntry.date | htmlDateString }}"
        >{{ latestEntry.date | readableDate }}</time
      ></small
    >
  {% endif %}
  <h1 class="largeTitle">Gamelog</h1>
  <p>
    Playing games is one of my favorite things to do in my free time. Over the
    years, I've played a lot of games and this page is an effort in publicly
    cataloguing this.
  </p>
</header>

<section class="o-grid__page">
  <ul>
    {% for game in gamesWithColors | sortByLatestEntry(collections.gamelog) %}
      <li class="border-t border-primary--10 py-1">
        <a
          href="/gamelog/{{ game.slug }}/"
          class="group flex md:items-center gap-4 p-3 rounded-md hover:bg-primary--10 active:opacity-100! transition-colors"
        >
          <img
            src="/src/assets/images/games/{{ game.cover }}"
            alt=""
            class="mix-blend-luminosity size-8 transition-all duration-300 will-change-transform group-hover:scale-110 group-hover:rotate-4 group-hover:mix-blend-normal"
          />
          <div class="flex flex-col md:flex-row md:flex-1 md:items-center">
            <h2 class="mb-0! md:flex-1 text-primary">{{ game.title }}</h2>
            <ul class="flex items-center">
              <li>
                <small>{{ game.platform }}</small>
              </li>
              <li class="mx-1.5">
                <small class="opacity-50">/</small>
              </li>
              <li>
                <small>{{ game.status }}</small>
              </li>
              <li class="mx-1.5">
                <small class="opacity-50">/</small>
              </li>
              <li>
                {% set count = collections.gamelog | filterByGame(game.slug) | length %}
                <small
                  >{{ count }} entr{{ "y" if count == 1 else "ies" }}</small
                >
              </li>
            </ul>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
