---
layout: layouts/base.njk
title: Gamelog
permalink: /gamelog/
---

<h1>Gamelog</h1>

<ul class="gamelog-list">
  {% for game in gamesWithColors %}
    <li class="gamelog-item">
      <div class="w-full h-10" style="background-color: {{ game.dominantColor }};"></div>
      <span class="gamelog-title">{{ game.title }}</span>
      <span class="gamelog-platform">{{ game.platform }}</span>
    </li>
  {% endfor %}
</ul>
