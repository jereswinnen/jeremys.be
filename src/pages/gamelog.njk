---
layout: layouts/base.njk
title: Gamelog
permalink: /gamelog/
---

{% set latestEntry = collections.gamelog | first %}
<header class="o-grid__content o-prose">
  {% if latestEntry %}
    <small
      >Last updated:
      <time datetime="{{ latestEntry.date | htmlDateString }}"
        >{{ latestEntry.date | readableDate }}</time
      ></small
    >
  {% endif %}
  <h1 class="largeTitle">Gamelog</h1>
  <p>
    Playing games is one of my favorite things to do in my free time. Over the
    years, I've played a lot of games and this page is an effort in publicly
    cataloguing this.
  </p>
</header>

<section class="o-grid__content">
  <ul class="space-y-2">
    {% for game in gamesWithColors | sortByLatestEntry(collections.gamelog) %}
      <li>
        <a href="/gamelog/{{ game.slug }}/" class="flex items-center gap-4 p-3 rounded-lg hover:bg-neutral-tertiary/20 transition-colors">
          <img src="/assets/images/games/{{ game.cover }}" alt="" class="size-12 rounded" />
          <span class="flex-1 font-medium">{{ game.title }}</span>
          <span class="text-neutral-secondary text-sm">{{ game.platform }}</span>
          <span class="text-neutral-secondary text-sm">{{ game.status }}</span>
          {% set count = collections.gamelog | filterByGame(game.slug) | length %}
          <span class="text-neutral-secondary text-sm">{{ count }} entries</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
