---
layout: layouts/base.njk
title: Gamelog
permalink: /gamelog/
---

{% set latestEntry = collections.gamelog | first %}
<header class="o-grid__content o-prose">
  {% if latestEntry %}
    <small
      >Last updated:
      <time datetime="{{ latestEntry.date | htmlDateString }}"
        >{{ latestEntry.date | readableDate }}</time
      ></small
    >
  {% endif %}
  <h1>Gamelog</h1>
  <p>
    Playing games is one of my favorite things to do in my free time. Over the
    years, I've played a lot of games and this page is an effort in publicly
    cataloguing this.
  </p>
</header>

<section class="o-grid__page">
  <ul
    class="flex flex-col items-center md:flex-row md:items-end gap-2 flex-wrap"
  >
    {% for game in gamesWithColors | sortByLatestEntry(collections.gamelog) %}
      <li
        class="group md:w-fit md:last:rotate-2 last:origin-bottom-left transition-all duration-300 last:hover:rotate-0"
      >
        <a
          href="/gamelog/{{ game.slug }}/"
          class="p-4 flex items-end justify-between w-(--bar-w) md:w-fit md:min-h-(--bar-h) rounded-md text-(--text-color)! bg-(--bg-color) gamelog__bar--bg md:[writing-mode:vertical-rl] md:[text-orientation:mixed] transition-all duration-300 group-hover:opacity-100! group-hover:-translate-y-2 group-hover:last:translate-y-0!"
          style="--bar-w: {{ game.barWidth }}%; --bar-h: {{ game.barHeight }}px; --text-color: {{ game.textColor }}; --bg-color: {{ game.backgroundColor }}; --bg-cover: url('/assets/images/games/{{ game.cover }}');"
        >
          <header class="flex flex-col z-10">
            <h3>{{ game.title }}</h3>
            <small class="opacity-80" style="color: var(--text-color);"
              >{{ game.platform }}</small
            >
          </header>
          <small class="opacity-80 z-10" style="color: var(--text-color);"
            >{{ game.status }}</small
          >
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
